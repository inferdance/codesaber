    "dev:web": "pnpm --filter @saber/web dev",
    "saber": "pnpm --filter @saber/cli run saber"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
